<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <%- include("partials/header.ejs") %>
    <div class="main_content">
        <h1>Speak Your Mind</h1>
        <!-- Form action configured by backend routing. Will either create a new post or update an old one. -->
         <!-- Text inputs will autofill with the associated post's title and content when applicable. -->
        <form action=<%= action %> method="post">
            <label for="title">Title</label>
            <input type="text" name="title" value="<%= (postIndex != -1) ? posts[postIndex].title : "";%>">
            <label for="content">Content</label>
            <input type="text" name="content" value="<%= (postIndex != -1) ? posts[postIndex].content : "" %>">
            <input type="submit" value="Submit">
        </form>
    </div>
    <%- include("partials/footer.ejs") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
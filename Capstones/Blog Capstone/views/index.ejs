<!-- EJS for the index page. -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Da' Blog</title>
    <link rel="stylesheet" href="styles/main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <div class="container-lg d-flex text-center vh-100 align-items-center justify-content-center pb-5">
        <div class="row justify-content-md-center">
            <h1>Da' Blog!</h1>
            <h3>A private blog, just for you! Login below to start.</h3>

            <!-- Authentication not yet implemented.  -->
            <form action="/posts" method="get" class="mt-4 w-100">
                <div class="d-flex flex-column align-items-center justify-content-center">
                    <section class="form-floating mb-3 col-3">
                        <input type="text" name="email" class="form-control" placeholder="email@example.com">
                        <label for="email">Email</label>
                    </section>
                    <section class="form-floating mb-2 col-3">
                        <input type="password" name="pswd" class="form-control" placeholder="password">
                        <label for="pswd">Password</label>
                    </section>
                    <!-- <input type="submit" name="login" value="Login"> -->
                    <button class="btn btn-primary col-1" type="submit">Login</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body class="d-flex flex-column min-vh-100">
    <%- include("partials/header.ejs") %>
    <div class="container-lg text-center flex-grow-1 mt-5">
        <h1>Your Posts</h1>
        <!-- If the user has created posts, they are displayed. Otherwise an alternative message is displayed. -->
        <% if(posts.length > 0) { %>
            <ul class="list-group">
                <% posts.forEach((post, index) => { %>
                    <li class="list-group-item d-flex justify-content-between">
                        <section class="text-start">
                            <strong><%= post.title %></strong>
                            <p><%= post.content %></p>
                        </section>
                        <section class="d-flex flex-column justify-content-between">
                            <p><%= post.date %></p>
                            <section class="d-flex">
                                <!-- Edits the post -->
                                <form action="<%= `/editor` %>" method="get">
                                    <input type="hidden" name="postIndex" value=<%= index %>>
                                    <button class="btn btn-primary btn-sm me-2" type="submit">Edit</button>
                                </form>
                                <!-- Deletes the post -->
                                <form action="<%= `/delete?_method=DELETE` %>" method="post">
                                    <input type="hidden" name="postIndex" value=<%= index %>>
                                    <button class="btn btn-primary btn-sm" type="submit">Delete</button>
                                </form>
                            </section>
                        </section>
                    </li>
                <% }); %>
            </ul>
            <a href="/editor"><button type="button" class="btn btn-success btn-lg mt-4">New Post +</button></a>
        <% }else{ %>
            <h3>No one here but us chickens.</h3>
            <h3>Why not make your first post?</h3>
            <a href="/editor"><button type="button" class="btn btn-success btn-lg mt-4">New Post +</button></a>
        <% } %>
    </div>
    <%- include("partials/footer.ejs") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <%- include("partials/header.ejs") %>
    <div class="container-lg text-center vh-100">
        <h1>Your Posts</h1>
        <!-- If the user has created posts, they are displayed. Otherwise an alternative message is displayed. -->
        <% if(posts.length > 0) { %>
            <ul>
                <% posts.forEach((post, index) => { %>
                    <li>
                        <p><%= post.title %></p>
                        <p><%= post.content %></p>
                        <!-- Edits the post -->
                        <form action=<%= `/editor?postIndex=${index}` %> method="get">
                            <input type="submit" value="Edit">
                        </form>
                        <!-- Deletes the post -->
                        <form action=<%= `/delete?_method=DELETE&postIndex=${index}` %> method="post">
                            <input type="submit" value="Delete">
                        </form>
                    </li>
                <% }); %>
            </ul>
            <h3><a href="/editor">New Post</a></h3>
        <% }else{ %>
            <h3>No one here but us chickens.</h3>
            <h3>Why not make your first post?</h3>
            <a href="/editor">Post</a>
        <% } %>
    </div>
    <%- include("partials/footer.ejs") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>